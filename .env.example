# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Generate a fresh key with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-me-with-a-freshly-generated-key

# Which settings module to load: vivacalc.settings.dev | vivacalc.settings.prod
DJANGO_SETTINGS_MODULE=vivacalc.settings.dev

# Production only ----------------------------------------------------------
DEBUG=False
ALLOWED_HOSTS=vivacalc.example.com,www.vivacalc.example.com
CSRF_TRUSTED_ORIGINS=https://vivacalc.example.com

# Leave unset to use SQLite at BASE_DIR/db.sqlite3.
# PostgreSQL example:
# DATABASE_URL=postgres://vivacalc:password@localhost:5432/vivacalc

# Business operating timezone (affects what counts as "today").
TIME_ZONE=Asia/Kolkata

# Login throttle
LOGIN_ATTEMPT_LIMIT=5
LOGIN_ATTEMPT_COOLOFF_MINUTES=15

# Largest export permitted in a single request.
EXPORT_MAX_ROWS=10000

LOG_LEVEL=INFO

# --- LAN deployment (vivacalc.settings.lan) -------------------------------
# Fixed hostname devices will use. Must match the Windows computer name so
# mDNS advertises it: computer "myserver" -> myserver.local
LAN_HOSTNAME=myserver.local

# DHCP pool the server's lease moves inside. Every address in this range is
# added to ALLOWED_HOSTS, so the app keeps answering when the lease changes.
DHCP_SUBNET=192.168.1
DHCP_RANGE_START=50
DHCP_RANGE_END=150

# Waitress
WAITRESS_HOST=0.0.0.0
WAITRESS_PORT=80
WAITRESS_THREADS=8

# Any extra names/origins (e.g. a router DNS entry like myserver.lan)
# EXTRA_ALLOWED_HOSTS=myserver.lan
# EXTRA_CSRF_TRUSTED_ORIGINS=http://myserver.lan

# --- Sign-in / sign-out email notifications -------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=you@gmail.com
DEFAULT_FROM_EMAIL=you@gmail.com
# A Gmail *app password*, not the account password. Generate at
# https://myaccount.google.com/apppasswords  (needs 2-Step Verification on).
# Spaces are stripped automatically, so the displayed form pastes fine.
EMAIL_HOST_PASSWORD=

AUTH_NOTIFY_ENABLED=True
# Who is told, comma-separated.
AUTH_NOTIFY_RECIPIENTS=ops@example.com,manager@example.com
AUTH_NOTIFY_ON_LOGIN=True
AUTH_NOTIFY_ON_LOGOUT=True
# Also copy the person who signed in, at their own address.
AUTH_NOTIFY_USER_TOO=False
